{{!
    @template quizaccess_webcamproctor/preflight

    What webcam proctoring does, shown to the student before they agree.

    Context variables required for this template:
    * intro - Introductory sentence.
    * items - List of notice items, each with text.

    Example context (json):
    {
        "intro": "This quiz uses webcam proctoring.",
        "items": [{"text": "A photo is taken when you start."}]
    }
}}
<div class="webcamproctor-notice mb-3">
    <p>{{intro}}</p>
    <ul class="webcamproctor-notice-list">
        {{#items}}
        <li>{{{text}}}</li>
        {{/items}}
    </ul>
</div>
