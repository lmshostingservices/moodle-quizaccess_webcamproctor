{{!
    @template quizaccess_webcamproctor/camera

    Camera preview and baseline photo controls in the quiz preflight form.

    Example context (json):
    {}
}}
<div class="webcamproctor-camera" data-region="webcamproctor-camera">
    <div class="webcamproctor-preview">
        <video data-region="video" autoplay playsinline muted aria-label="{{#str}}camera_preview, quizaccess_webcamproctor{{/str}}"></video>
        <img data-region="photo" alt="{{#str}}baseline_photo, quizaccess_webcamproctor{{/str}}" hidden>
        <canvas data-region="canvas" hidden></canvas>
    </div>
    <p class="webcamproctor-status" data-region="status" role="status" aria-live="polite">{{#str}}camera_off, quizaccess_webcamproctor{{/str}}</p>
    <div class="webcamproctor-controls">
        <button type="button" class="btn btn-secondary" data-action="start">{{#str}}camera_start, quizaccess_webcamproctor{{/str}}</button>
        <button type="button" class="btn btn-primary" data-action="capture" disabled>{{#str}}preflight_button, quizaccess_webcamproctor{{/str}}</button>
        <button type="button" class="btn btn-secondary" data-action="retake" hidden>{{#str}}preflight_retake, quizaccess_webcamproctor{{/str}}</button>
    </div>
</div>
